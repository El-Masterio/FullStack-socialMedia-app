# Copy this file to .env and fill in your own values.
# NOTE: Create React App inlines every REACT_APP_* variable into the public
# JavaScript bundle. Anything here is readable by anyone who visits the site,
# so only ever put PUBLIC values in these variables.

# Google OAuth client ID - public by design.
REACT_APP_GOOGLE_API_TOKEN=your-google-client-id.apps.googleusercontent.com

# Sanity project ID - public by design.
REACT_APP_SANITY_PROJECT_ID=your-sanity-project-id

# Sanity token. WARNING: this ends up in the browser bundle.
# Use a READ-ONLY (viewer) token here, never a write/deploy token.
# For writes, make the dataset public-write or proxy through a backend.
REACT_APP_SANITY_TOKEN=your-sanity-read-token
